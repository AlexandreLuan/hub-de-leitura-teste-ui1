pipeline {
    agent any
    tools {
        nodejs "nodejs"
    }
    stages {
        stage('Clonar o hub de leitura integrado') {
            steps {
                bat 'if exist hub-de-leitura-integrado2 rd /s /q hub-de-leitura-integrado2'
                bat 'git clone https://github.com/EBAC-QE/hub-de-leitura-integrado2.git'
            }
        }
        stage('Instalar dependências e Executar Testes') {
            steps {
                dir('hub-de-leitura-integrado2') {
                    bat 'npm install'
                    
                    // Sobe o servidor, testa se a porta 3000 responde e roda o Cypress
                    bat 'npx start-server-and-test start http://localhost:3000 cypress:run'
                }
            }
        }
    }
}
pipeline {
    agent any
    tools {
        nodejs "nodejs"
    }
    stages {
        stage('Instalar Dependências e Backend') {
            steps {
                // 1. Instala as dependências do Cypress na raiz do projeto do Jenkins
                bat 'npm install'
                
                // 2. Prepara o backend clonando na pasta isolada
                bat 'if exist backend-app rmdir /s /q backend-app'
                bat 'git clone https://github.com/EBAC-QE/hub-de-leitura-integrado2.git backend-app'
                
                // 3. Instala as dependências do backend
                dir('backend-app') {
                    bat 'npm install'
                }
            }
        }
        stage('Executar Testes Cypress') {
            steps {
                // Sobe o servidor do backend em background e executa o Cypress na raiz
                bat 'npx start-server-and-test "npm start --prefix backend-app" http://localhost:3000 "npx cypress run"'
            }
        }
    }
}
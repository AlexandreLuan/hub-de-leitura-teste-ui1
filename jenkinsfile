pipeline {
    agent any
    tools {
        nodejs "nodejs"
    }
    stages {
        stage('Clonar o hub de leitura integrado') {
            steps {
                // Comando seguro para apagar a pasta no Windows se ela já existir
                bat 'if exist hub-de-leitura-integrado2 rmdir /s /q hub-de-leitura-integrado2'
                bat 'git clone https://github.com/EBAC-QE/hub-de-leitura-integrado2.git'
            }
        }
        stage('Instalar dependências e Executar Testes') {
            steps {
                dir('hub-de-leitura-integrado2') {
                    bat 'npm install'
                    bat 'npx start-server-and-test start http://localhost:3000 "npx cypress run"'
                }
            }
        }
    }
}
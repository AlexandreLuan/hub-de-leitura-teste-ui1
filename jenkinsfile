pipeline {
    agent any
    tools {
        nodejs "nodejs"
    }
    stages {
        stage('Preparar Servidor (Backend)') {
            steps {
                // Limpa e clona o repositório do backend em uma pasta isolada
                bat 'if exist backend-app rmdir /s /q backend-app'
                bat 'git clone https://github.com/EBAC-QE/hub-de-leitura-integrado2.git backend-app'
                
                // Instala as dependências do backend
                dir('backend-app') {
                    bat 'npm install'
                }
            }
        }
        stage('Executar Testes Cypress') {
            steps {
                // Sobe o servidor do backend em background, espera a porta 3000 abrir, 
                // e roda o Cypress na raiz do SEU projeto de testes (onde está o cypress.config.js)
                bat 'npx start-server-and-test "npm start --prefix backend-app" http://localhost:3000 "npx cypress run"'
            }
        }
    }
}